rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'hayashirika05@gmail.com';
    }

    function emoManagerPath() {
      return /databases/$(database)/documents/artifacts/hayashi-rika-player/public/data/managers/$(request.auth.token.email);
    }

    function isEmoManager() {
      return signedIn()
        && request.auth.token.email != null
        && (isPrimaryAdmin() || exists(emoManagerPath()));
    }

    function isActivePinboardUser() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/artifacts/pinboard-app/moderation/$(request.auth.uid))
          || get(/databases/$(database)/documents/artifacts/pinboard-app/moderation/$(request.auth.uid)).data.disabled != true);
    }

    match /artifacts/pinboard-app/public/data/pinboard_posts/{postId} {
      allow read: if true;
      allow create: if isActivePinboardUser()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isPrimaryAdmin()
        || (isActivePinboardUser()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likes', 'starredBy']));
      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || isPrimaryAdmin());
    }

    match /artifacts/pinboard-app/users/{userId}/profile/info {
      allow read, write: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdmin());
    }

    match /artifacts/pinboard-app/admin_profiles/{userId} {
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow read, delete: if isPrimaryAdmin();
    }

    match /artifacts/pinboard-app/moderation/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdmin());
      allow write: if isPrimaryAdmin();
    }

    match /artifacts/pinboard-app/admin_config/settings {
      allow read, write: if isPrimaryAdmin();
    }

    match /artifacts/hayashi-rika-player/public/data/songs/{songId} {
      allow read, create, update, delete: if isEmoManager();
    }

    match /artifacts/hayashi-rika-player/public/data/managers/{email} {
      allow read: if true;
      allow create, update, delete: if isPrimaryAdmin();
    }

    match /artifacts/hayashi-rika-player/public/data/ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isEmoManager();
    }

    match /artifacts/hayashi-rika-player/users/{userId}/{document=**} {
      allow read, write: if signedIn()
        && request.auth.uid == userId
        && isEmoManager();
    }
  }
}
